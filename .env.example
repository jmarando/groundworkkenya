# Groundwork — local development environment.
# Copy to .env and fill in. .env is gitignored and must never be committed:
# this repository is public.
#
# In deployment these are supplied by Lovable Cloud env vars, not by this file.

# ---- Supabase (safe in the browser; protected by row level security) ----
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="<project>"
VITE_SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project>"

# ---- Server only. Never prefix these with VITE_: that would ship them to the browser. ----
# Bypasses row level security. Treat like a root password.
SUPABASE_SERVICE_ROLE_KEY=""

# Listening sweep
FIRECRAWL_API_KEY=""
LOVABLE_API_KEY=""
LISTENING_CRON_TOKEN=""

# Social webhooks
META_APP_SECRET=""
META_VERIFY_TOKEN=""
X_CONSUMER_SECRET=""

# ---- Campaign ----
# Used as the SMS sender tag ("NJOKI2027: ...") and in replies.
CAMPAIGN_NAME="Groundwork"
# Where public poll links point: <PUBLIC_ORIGIN>/p/<code>
PUBLIC_ORIGIN="https://groundworkkenya.lovable.app"

# ---- Channels: off until credentials are supplied. Outbox stays in dry-run. ----
# Africa's Talking (SMS + USSD + airtime)
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""
AT_USSD_CODE=""
# Africa's Talking does not sign callbacks, so the callback URLs carry this:
#   https://<host>/api/public/sms/inbound?token=<AT_CALLBACK_TOKEN>
#   https://<host>/api/public/ussd?token=<AT_CALLBACK_TOKEN>
# Long and random, e.g. `openssl rand -hex 32`. Unset = both endpoints refuse.
AT_CALLBACK_TOKEN=""
# M-Pesa Daraja B2C
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_INITIATOR_NAME=""
MPESA_SECURITY_CREDENTIAL=""
# Set to "true" only when you intend to send for real — and only after
# /api/public/outbox/drain is on a schedule (every minute), sent with
# header x-cron-secret: <OUTBOX_CRON_TOKEN>.
CHANNELS_LIVE="false"
OUTBOX_CRON_TOKEN=""
